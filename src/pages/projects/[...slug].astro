---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/Tag.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article class="max-w-3xl mx-auto px-6 pt-16 pb-24 sm:pt-20">
    <a href="/projects" class="font-mono text-sm text-accent hover:text-accent-strong transition-colors">
      &larr; all projects
    </a>

    <div class="mt-6 flex items-start justify-between gap-4">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-ink">
        {project.data.title}
      </h1>
      <span class="font-mono text-sm text-ink-faint shrink-0 pt-1">{project.data.year}</span>
    </div>

    <p class="mt-4 text-lg text-ink-soft leading-relaxed">
      {project.data.summary}
    </p>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      {project.data.stack.map((item) => <Tag label={item} />)}
      {project.data.kind === "client-generalized" && (
        <span class="font-mono text-xs text-ink-faint italic">
          client work — described in general, non-identifying terms
        </span>
      )}
    </div>

    <div class="prose-case-study mt-10">
      <Content />
    </div>
  </article>
</BaseLayout>
