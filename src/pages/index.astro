---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const featured = allProjects.sort((a, b) => a.data.order - b.data.order).slice(0, 3);

const capabilities = [
  {
    label: "pipelines & lakes",
    body: "Production data pipelines and lake architecture in Python, SQL, and PySpark, designed for correctness and lineage, not just throughput.",
  },
  {
    label: "cloud & on-prem",
    body: "Equally at home in the cloud and on-premises, primarily on Azure (Data Factory, Synapse), including the migrations and integrations that connect the two without breaking downstream consumers.",
  },
  {
    label: "regulated data modeling",
    body: "Payment, claims, and risk data modeled at production scale, where a schema mistake has compliance consequences, not just a bad report.",
  },
  {
    label: "automation & tooling",
    body: "Internal tools and automation that remove manual steps from a pipeline, built the same way whether it's for an enterprise client or my own infrastructure.",
  },
];
---

<BaseLayout
  title="Lauren Chaplinski"
  description="Independent data engineer and architect. Production data systems, cloud migrations, and pipeline architecture, proven in regulated, high-stakes environments."
>
  <section class="max-w-4xl mx-auto px-6 pt-16 pb-20 sm:pt-24 sm:pb-28">
    <p class="font-mono text-sm text-accent mb-4">$ whoami</p>
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight text-ink leading-[1.15] max-w-3xl">
      I build data systems that hold up under regulatory scrutiny, then apply that rigor everywhere else.
    </h1>
    <p class="mt-6 text-lg text-ink-soft max-w-2xl leading-relaxed">
      Eight years designing and running production pipelines, data lakes, and cloud
      migrations, primarily in Python, SQL, and Azure, with SAS depth from a
      decade-plus in regulated data. Twelve-plus years working specifically with
      claims and risk data. I'm not a healthcare specialist. I'm a data engineer whose
      standards were set in environments where "close enough" isn't a valid answer.
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-4">
      <a
        href="/resume.pdf"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded bg-ink text-paper font-medium text-sm hover:bg-accent-strong transition-colors"
      >
        View résumé
      </a>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded border border-border text-ink font-medium text-sm hover:border-accent hover:text-accent-strong transition-colors"
      >
        Get in touch
      </a>
    </div>
  </section>

  <section class="border-y border-border bg-paper-alt">
    <div class="max-w-4xl mx-auto px-6 py-14">
      <p class="font-mono text-xs uppercase tracking-wider text-ink-faint mb-8">
        what i do
      </p>
      <div class="grid sm:grid-cols-2 gap-x-10 gap-y-8">
        {capabilities.map((cap) => (
          <div>
            <h2 class="font-mono text-sm text-accent-strong mb-2">{cap.label}</h2>
            <p class="text-ink-soft text-sm leading-relaxed">{cap.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-16 sm:py-20">
    <div class="flex items-baseline justify-between mb-8">
      <p class="font-mono text-xs uppercase tracking-wider text-ink-faint">
        selected work
      </p>
      <a href="/projects" class="font-mono text-sm text-accent hover:text-accent-strong transition-colors">
        all projects &rarr;
      </a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {featured.map((project) => (
        <ProjectCard
          slug={project.id}
          title={project.data.title}
          summary={project.data.summary}
          stack={project.data.stack}
          year={project.data.year}
          kind={project.data.kind}
        />
      ))}
    </div>
  </section>
</BaseLayout>
