---
import Tag from "./Tag.astro";

interface Props {
  slug: string;
  title: string;
  summary: string;
  stack: string[];
  year: string;
  kind: "personal" | "client-generalized";
}

const { slug, title, summary, stack, year, kind } = Astro.props;
---

<a
  href={`/projects/${slug}`}
  class="group block border border-border rounded-lg p-6 hover:border-accent hover:shadow-sm transition-all bg-white/40"
>
  <div class="flex items-start justify-between gap-4 mb-3">
    <h3 class="text-lg font-semibold text-ink group-hover:text-accent-strong transition-colors">
      {title}
    </h3>
    <span class="font-mono text-xs text-ink-faint shrink-0 pt-1">{year}</span>
  </div>
  <p class="text-ink-soft text-sm leading-relaxed mb-4">{summary}</p>
  <div class="flex flex-wrap items-center gap-2">
    {stack.map((item) => <Tag label={item} />)}
    {kind === "client-generalized" && (
      <span class="font-mono text-xs text-ink-faint italic">client work, generalized</span>
    )}
  </div>
</a>
