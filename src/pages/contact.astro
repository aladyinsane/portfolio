---
import BaseLayout from "../layouts/BaseLayout.astro";

const email = "hi@laurenchaplinski.com";
const github = "https://github.com/aladyinsane";
const linkedin = "https://www.linkedin.com/in/lauren-chaplinski";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Lauren Chaplinski about contract data engineering work."
>
  <section class="max-w-2xl mx-auto px-6 pt-16 pb-24 sm:pt-20">
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-ink mb-6">
      Let's talk
    </h1>
    <p class="text-ink-soft leading-relaxed max-w-xl mb-4">
      Open to independent contract data engineering work: pipeline builds, cloud
      migrations, data architecture, or a second set of experienced eyes on a system
      already in flight. Email is the fastest way to reach me.
    </p>
    <p class="text-ink-soft leading-relaxed max-w-xl mb-10">
      Based in Chicago. Open to remote or Chicago-area hybrid engagements, typically
      6-12 months.
    </p>

    <div class="flex flex-col sm:flex-row gap-4">
      <a
        href={`mailto:${email}`}
        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded bg-ink text-paper font-medium text-sm hover:bg-accent-strong transition-colors"
      >
        {email}
      </a>
      <a
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded border border-border text-ink font-medium text-sm hover:border-accent hover:text-accent-strong transition-colors"
      >
        LinkedIn
      </a>
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded border border-border text-ink font-medium text-sm hover:border-accent hover:text-accent-strong transition-colors"
      >
        GitHub
      </a>
    </div>

    <p class="font-mono text-xs text-ink-faint mt-10">$ contact --lauren</p>
  </section>
</BaseLayout>
